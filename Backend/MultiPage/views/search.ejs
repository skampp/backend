<!-- Search and Copy -->
<div class="container">
  <form action="/submit" method="post">
    <div class="div-spacing">
      <input
        type="text"
        name="answer"
        id="userInput"
        placeholder="Bible reference"
        autofocus
      />
    </div>
    <div class="div-spacing"><button type="submit">Thumper Search</button></div>
    <div class="div-spacing">
      <button id="copyButton" class="narrow-button" type="button">
        Copy Passage
      </button>
    </div>
  </form>
</div>
